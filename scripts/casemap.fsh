// Generates src/casemap.fsh: the C runtime's case tables, taken from JavaScript's own
// toUpperCase and toLowerCase and its Cased and Case_Ignorable properties, so Fish's case
// mapping matches the JavaScript engine that made them. The tables are a recorded answer, kept
// with the tests' other reference answers; scripts/references.fsh records them anew.
//   fishc run scripts/casemap.fsh
import { writeFileSync } from "node:fs";
import { join } from "node:path";
import { recordedTables } from "./casetables.fsh";

function hex(n: i64): string {
  const digits = "0123456789abcdef";
  let out = "";
  let v = n;
  while (true) {
    out = digits[(v % 16) as usize]! + out;
    v = v / 16;
    if (v === 0) return out;
  }
}

function pairs(name: string, rows: Ref<i64[][]>): string {
  const body = rows.map((r) => `{0x${hex(r[0]!)},0x${hex(r[1]!)}}`).join(",").replace(/(.{100}[^,]*,)/g, "$1\n");
  return `static const uint32_t ${name}[][2] = {\n${body}\n};\n`;
}

function specials(name: string, rows: Ref<i64[][]>): string {
  const body = rows.map((r) => {
    let to: string[] = [];
    for (let i: usize = 1; i < 4; i++) to.push(`0x${hex(i < r.length ? r[i]! : 0)}`);
    return `{0x${hex(r[0]!)},${to.join(",")}}`;
  }).join(",\n");
  return `static const uint32_t ${name}[][4] = {\n${body}\n};\n`;
}

function main(): void throws Error | JsonError | IoError {
  const t = recordedTables(join(import.meta.dir, ".."));
  const c = [
    pairs("fsh_upper", t.upper),
    pairs("fsh_lower", t.lower),
    specials("fsh_upper_special", t.upperSpecial),
    specials("fsh_lower_special", t.lowerSpecial),
    pairs("fsh_cased", t.cased),
    pairs("fsh_case_ignorable", t.ignorable),
  ].join("\n");
  writeFileSync(
    join(import.meta.dir, "..", "src", "casemap.fsh"),
    `// Generated by scripts/casemap.fsh from JavaScript's case mapping; do not edit.\n// Each table is sorted by its first column, for binary search.\nexport const CASEMAP = String.raw\`\n${c}\`;\n\n// The Unicode version of the engine the tables were made from.\nexport const CASEMAP_UNICODE = ${JSON.stringify(t.unicode)};\n`,
  );
  console.log(`upper ${t.upper.length}+${t.upperSpecial.length}, lower ${t.lower.length}+${t.lowerSpecial.length}`);
}
