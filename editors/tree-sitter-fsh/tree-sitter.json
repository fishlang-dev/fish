{
  "grammars": [
    {
      "name": "fsh",
      "camelcase": "Fsh",
      "title": "Fish Lang",
      "scope": "source.fsh",
      "path": ".",
      "file-types": ["fsh"],
      "highlights": [
        "queries/highlights.scm",
        "node_modules/tree-sitter-typescript/queries/highlights.scm",
        "node_modules/tree-sitter-javascript/queries/highlights.scm"
      ],
      "injections": "node_modules/tree-sitter-javascript/queries/injections.scm",
      "locals": [
        "node_modules/tree-sitter-typescript/queries/locals.scm",
        "node_modules/tree-sitter-javascript/queries/locals.scm"
      ],
      "tags": [
        "queries/tags.scm",
        "node_modules/tree-sitter-typescript/queries/tags.scm",
        "node_modules/tree-sitter-javascript/queries/tags.scm"
      ],
      "injection-regex": "^(fsh|fishlang)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Fish Lang (.fsh) grammar for tree-sitter",
    "links": { "repository": "https://github.com/fishlang-dev/fish" }
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false }
}
