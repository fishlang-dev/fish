// The JavaScript a `--target js` module starts with: `$fsh`, the helpers its code calls where
// JavaScript's own operators would mean something else than Fish's. Integers that fit a double
// exactly are numbers, checked against the safe-integer range; `u64`, `i128` and `u128` are
// BigInts, checked against their width. A panic writes Fish's `panicked at` lines and leaves with
// 101, and only a `catch` the program didn't write stops it. The helpers reach JavaScript's own
// names through `globalThis`, so a class the program declares as `Error` or `Map` hides nothing
// they use.
export function jsRuntime(release: boolean): string {
  return [
    "const $fsh = (() => {",
    "  const G = globalThis;",
    `  const RELEASE = ${release ? "true" : "false"};`,
    "  const WIDTH = { i8: 8, i16: 16, i32: 32, i64: 64, isize: 64, i128: 128, u8: 8, u16: 16, u32: 32, u64: 64, usize: 64, u128: 128 };",
    "  const SIGNED = { i8: true, i16: true, i32: true, i64: true, isize: true, i128: true };",
    "  const BIG = { i128: true, u64: true, u128: true, bigint: true };",
    "  const SAFE = { i64: true, isize: true, usize: true };",
    '  const VERB = { "+": "add", "-": "subtract", "*": "multiply", "**": "multiply", "/": "divide", "%": "calculate the remainder" };',
    "  class Panic extends G.Error {}",
    "  function panic(reason, at) {",
    '    const text = "panicked at " + at + ":\\n" + reason + "\\n";',
    "    const p = G.process;",
    "    if (p !== undefined && p.stderr !== undefined) {",
    "      p.stderr.write(text);",
    "      p.exitCode = 101;",
    "    } else G.console.error(text.slice(0, -1));",
    "    throw new Panic(reason);",
    "  }",
    "  function limits(t) {",
    "    const bits = G.BigInt(WIDTH[t]);",
    "    return SIGNED[t] === true ? [-(1n << (bits - 1n)), (1n << (bits - 1n)) - 1n] : [0n, (1n << bits) - 1n];",
    "  }",
    "  function wrapped(r, t) {",
    "    return SIGNED[t] === true ? G.BigInt.asIntN(WIDTH[t], r) : G.BigInt.asUintN(WIDTH[t], r);",
    "  }",
    "  function out(r, t, verb, at) {",
    "    if (BIG[t] === true) return r;",
    "    const n = G.Number(r);",
    '    if (SAFE[t] === true && !G.Number.isSafeInteger(n)) return panic("attempt to " + verb + " with overflow", at);',
    "    return n;",
    "  }",
    "  function fits(r, t, verb, at) {",
    '    if (t === "bigint") return r;',
    "    const [lo, hi] = limits(t);",
    "    if (r < lo || r > hi) {",
    '      if (!RELEASE) return panic("attempt to " + verb + " with overflow", at);',
    "      r = wrapped(r, t);",
    "    }",
    "    return BIG[t] === true ? r : G.Number(r);",
    "  }",
    "  function ar(op, a, b, t, at, verb) {",
    "    const v = verb === undefined ? VERB[op] : verb;",
    '    if ((op === "/" || op === "%") && (b === 0 || b === 0n)) return panic(op === "/" ? "attempt to divide by zero" : "attempt to calculate the remainder with a divisor of zero", at);',
    "    if (SAFE[t] === true) {",
    '      const r = (op === "+" ? a + b : op === "-" ? a - b : op === "*" ? a * b : op === "**" ? a ** b : op === "/" ? (a - (a % b)) / b : a % b) + 0;',
    '      if (!G.Number.isSafeInteger(r) || (t === "usize" && r < 0)) return panic("attempt to " + v + " with overflow", at);',
    "      return r;",
    "    }",
    "    const A = G.BigInt(a);",
    "    const B = G.BigInt(b);",
    '    if (op === "%" && t !== "bigint" && SIGNED[t] === true && B === -1n && A === limits(t)[0]) return panic("attempt to calculate the remainder with overflow", at);',
    '    return fits(op === "+" ? A + B : op === "-" ? A - B : op === "*" ? A * B : op === "**" ? A ** B : op === "/" ? A / B : A % B, t, v, at);',
    "  }",
    "  function sh(op, a, b, t, at) {",
    '    const verb = "shift " + (op === "<<" ? "left" : "right");',
    '    if (t === "bigint") return op === "<<" ? a << b : a >> b;',
    "    const bits = WIDTH[t];",
    "    let n = G.Number(b);",
    "    if (n < 0 || n >= bits) {",
    '      if (!RELEASE) return panic("attempt to " + verb + " with overflow", at);',
    "      n = n & (bits - 1);",
    "    }",
    "    const A = G.BigInt(a);",
    "    const N = G.BigInt(n);",
    '    const r = op === "<<" ? wrapped(A << N, t) : op === ">>" ? A >> N : wrapped(G.BigInt.asUintN(bits, A) >> N, t);',
    "    return out(r, t, verb, at);",
    "  }",
    "  function bit(op, a, b, t, at) {",
    '    if (t === "bigint") return op === "&" ? a & b : op === "|" ? a | b : a ^ b;',
    "    const A = G.BigInt(a);",
    "    const B = G.BigInt(b);",
    '    return out(wrapped(op === "&" ? A & B : op === "|" ? A | B : A ^ B, t), t, "combine bits", at);',
    "  }",
    "  function not(a, t, at) {",
    '    if (t === "bigint") return ~a;',
    '    return out(wrapped(~G.BigInt(a), t), t, "negate", at);',
    "  }",
    "  function cast(v, from, to, at) {",
    '    if (to === "f64") return G.Number(v);',
    '    if (to === "f32") return G.Math.fround(G.Number(v));',
    "    let r;",
    '    if (from === "f64" || from === "f32") {',
    "      if (G.Number.isNaN(v)) r = 0n;",
    '      else if (to === "bigint") r = G.BigInt(G.Math.trunc(v));',
    "      else {",
    "        const [lo, hi] = limits(to);",
    "        r = v <= G.Number(lo) ? lo : v >= G.Number(hi) ? hi : G.BigInt(G.Math.trunc(v));",
    "      }",
    "    } else {",
    "      r = G.BigInt(v);",
    '      if (to !== "bigint") r = wrapped(r, to);',
    "    }",
    "    if (BIG[to] === true) return r;",
    "    const n = G.Number(r);",
    '    if (!G.Number.isSafeInteger(n)) return panic("attempt to convert to " + to + " with overflow", at);',
    "    return n;",
    "  }",
    "  function at(xs, i, place) {",
    '    if (i < 0 || i >= xs.length) return panic("index out of bounds: the len is " + xs.length + " but the index is " + i, place);',
    "    return xs[i];",
    "  }",
    "  function ix(xs, i, place) {",
    "    at(xs, i, place);",
    "    return i;",
    "  }",
    "  function some(v, reason, place) {",
    "    if (v === null || v === undefined) return panic(reason, place);",
    "    return v;",
    "  }",
    "  function check(holds, message, text, place) {",
    '    if (!holds) panic(message !== undefined ? message() : "assertion failed: " + text, place);',
    "  }",
    "  function parse(kind, s, radix) {",
    '    const n = kind === "parseInt" ? G.parseInt(s, radix) : kind === "parseFloat" ? G.parseFloat(s) : G.Number(s);',
    "    return G.Number.isNaN(n) ? null : n;",
    "  }",
    "  function copy(v) {",
    "    return G.Array.isArray(v) ? v.map(copy) : v;",
    "  }",
    "  function clone(v) {",
    '    if (typeof v !== "object" || v === null) return v;',
    "    if (G.Array.isArray(v)) return v.map(clone);",
    "    if (v instanceof G.Map) return new G.Map([...v].map(([k, x]) => [clone(k), clone(x)]));",
    "    if (v instanceof G.Set) return new G.Set([...v].map(clone));",
    "    const o = G.Object.create(G.Object.getPrototypeOf(v));",
    "    for (const k of G.Object.keys(v)) o[k] = clone(v[k]);",
    "    return o;",
    "  }",
    "  function upd(o, k, f, post) {",
    "    const old = o[k];",
    "    const v = f(old);",
    "    o[k] = v;",
    "    return post ? old : v;",
    "  }",
    "  function dict(o) {",
    "    return new G.Map(G.Object.entries(o));",
    "  }",
    "  function raise(e) {",
    "    throw e;",
    "  }",
    "  function pass(e) {",
    "    if (e instanceof Panic) throw e;",
    "  }",
    "  function once(f) {",
    "    let made = false;",
    "    let v;",
    "    return () => {",
    "      if (!made) {",
    "        v = f();",
    "        made = true;",
    "      }",
    "      return v;",
    "    };",
    "  }",
    "  function text(v) {",
    '    return typeof v === "bigint" ? G.String(v) : v;',
    "  }",
    "  function main(f) {",
    "    const ended = (e) => {",
    "      if (!(e instanceof Panic)) throw e;",
    "    };",
    "    try {",
    "      const r = f();",
    "      if (r instanceof G.Promise) r.catch(ended);",
    "    } catch (e) {",
    "      ended(e);",
    "    }",
    "  }",
    "  return { Panic, panic, ar, sh, bit, not, cast, at, ix, some, check, parse, copy, clone, upd, dict, raise, pass, once, text, main };",
    "})();",
    "",
  ].join("\n");
}
