// Many generic classes naming one generic class in their members' parameters share its
// definition's placeholders, so they don't count as instances that never end.
class Box<T> {
  v: T
  constructor(v: T) {
    this.v = v
  }
}

class C0<T> {
  v: T
  constructor(v: T) {
    this.v = v
  }
  m(b: Box<T>): i64 {
    return 0
  }
}

