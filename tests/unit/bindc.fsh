// `fishc bind c`: a C header's declarations read through clang as Fish, and a program built on
// what it wrote calling C.
import { writeFileSync } from "node:fs";
import { join } from "node:path";
import { spawnSync } from "node:child_process";
import { bindHeader } from "../../src/bindc.fsh";
import { built, fishc, removed, same, scratch } from "./support.fsh";

function put(path: string, text: string): void {
  try {
    writeFileSync(path, text);
  } catch (e) {
    assert(false, `can't write ${path}: ${e.message}`);
  }
}

const HEADER = `#include <stdint.h>
#define ANSWER 42
#define MASK (0xffu)
#define NEG -3
#define NAME "x"
typedef struct { int quot; int rem; } div_t;
struct pair { div_t a; uint8_t tag[4]; struct pair *next; };
enum color { RED, GREEN = 5, BLUE };
typedef enum { ONE = 1, TWO } count;
div_t div(int numerator, int denominator);
long labs(long n);
int sum(const struct pair *p, count c);
int printf(const char *format, ...);
static inline int twice(int x) { return 2 * x; }
union number { int a; float b; };
int (*getter(void))(int);
`;

const WANT = `// Generated by 'fishc bind c' from h.h; generate it again rather than editing it.

@c
export class div_t {
  quot: i32 = 0;
  rem: i32 = 0;
}

@c
export class pair {
  a: div_t = new div_t();
  tag: FixedArray<u8, 4> = FixedArray.filled<u8, 4>(0);
  next: MutPtr<pair> = unsafe { nullPtr<pair>() };
}

export enum color {
  RED = 0,
  GREEN = 5,
  BLUE = 6,
}
export enum count {
  ONE = 1,
  TWO = 2,
}
export declare function div(numerator: i32, denominator: i32): div_t;
export declare function labs(n: i64): i64;
export declare function sum(p: Ptr<pair>, c: i32): i32;

export const ANSWER: i64 = 42;
export const MASK: i64 = 255;
export const NEG: i64 = -3;
`;

test("a header's functions, structs, enums and integer defines become Fish, and the rest is listed", () => {
  const dir = scratch("fish-bindc-");
  try {
    put(join(dir, "h.h"), HEADER);
    const ran = fishc(dir, ["bind", "c", "h.h"]);
    same(ran.out, WANT, "the bindings");
    same(ran.err, [
      "skipped printf: it is variadic, which can't be called yet",
      "skipped twice: it is static or inline, so the library has no symbol for it",
      "skipped union number: C unions can't cross yet",
      "skipped getter: its type 'int (*(void))(int)' isn't a plain function",
      "",
    ].join("\n"), "what was left out");
  } finally {
    removed(dir);
  }
});

test("a program built on a header's bindings calls C through them", () => {
  const dir = scratch("fish-bindc-");
  try {
    put(join(dir, "h.h"), "typedef struct { int quot; int rem; } div_t;\ndiv_t div(int n, int d);\nlong labs(long n);\n#define TEN 10\n");
    const bound = fishc(dir, ["bind", "c", "h.h", "-o", "c.fsh"]);
    same(bound.err, "", "binding");
    const program = built(dir, "main", `import { div, labs, TEN } from "./c.fsh";\n\nfunction main() {\n  const d = unsafe { div(17, 5) };\n  console.log(d.quot, d.rem, unsafe { labs(-TEN) });\n}\n`);
    const run = spawnSync(program, [], {});
    same(new TextDecoder().decode(run.stdout), "3 2 10\n", "what the program printed");
  } finally {
    removed(dir);
  }
});

test("a header clang can't read is refused with clang's message", () => {
  let failed = false;
  try {
    bindHeader("/nonexistent/h.h", "clang", []);
  } catch (_e) {
    failed = true;
  }
  same(String(failed), "true", "the refusal");
});
